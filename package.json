{
  "name": "polaris",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "test": "bun run --filter '@polaris/*' test",
    "test:integration": "bun run --cwd apps/web test:integration",
    "db:clone-prod": "bun run --cwd apps/web db:clone-prod"
  },
  "trustedDependencies": ["unrs-resolver"]
}
