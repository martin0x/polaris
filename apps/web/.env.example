# Database
# DATABASE_URL is the runtime URL the app uses. In production this is the Neon
# pooled URL (with ?pgbouncer=true&connection_limit=1). Locally it's the
# Postgres in docker-compose.
DATABASE_URL=postgresql://polaris:polaris@localhost:5440/polaris
# DIRECT_DATABASE_URL is used by `prisma migrate` (and `prisma db push`).
# Required in production because pooled connections don't support prepared
# statements. Locally, leave unset — migrations will fall back to DATABASE_URL.
# DIRECT_DATABASE_URL=
# Optional — separate database for integration tests. If unset, integration tests skip.
DATABASE_URL_TEST=postgresql://polaris:polaris@localhost:5440/polaris_test

# Cron — shared secret for /api/cron/* routes; also doubles as the feedback
# service key for server-trusted writes. Generate with: openssl rand -base64 32
CRON_SECRET=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3 (production)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Local calendar day for server-side "today" (habits system). IANA name.
POLARIS_TZ="Asia/Manila"

# Convex — Convex Auth handles sign-in (Google OAuth, allowlist enforced in
# the backend). Deployment-side vars (AUTH_GOOGLE_ID, ALLOWED_EMAILS, etc.)
# are set on the Convex deployment — see packages/backend/README.md.
# NEXT_PUBLIC_CONVEX_URL is from packages/backend/.env.local CONVEX_URL
NEXT_PUBLIC_CONVEX_URL=

# Public origin for absolute metadata URLs (og:url, og:image, canonical) on the
# landing page. Optional on Vercel — VERCEL_PROJECT_PRODUCTION_URL is used when
# unset. Set it when the site lives on a custom domain Vercel doesn't report.
# SITE_URL=https://polaris.example.com
